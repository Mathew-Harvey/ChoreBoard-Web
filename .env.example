# Where the Vite dev server proxies /api requests to.
VITE_API_PROXY=http://localhost:4000

# Absolute API base URL. Empty in dev so requests stay relative and use the
# Vite proxy. In production set this to https://api.choreboard.io for both
# the web build and the Capacitor native build (the native build cannot use
# relative URLs because it is loaded from capacitor://localhost).
VITE_API_BASE_URL=

# Build target. 'web' (default) builds for app.choreboard.io.
# 'native' is set by `npm run cap:sync` so the SPA can switch to bearer-token
# auth and skip cookie-based session bootstrap.
VITE_BUILD_TARGET=web
